# cp .env.example .env 후 값 입력. .env 는 절대 커밋하지 마세요 (.gitignore 처리됨)
THRIWE_EMAIL=you@example.com
THRIWE_PASSWORD=
CARD_NUMBER=
CARD_EXPIRY=MM/YY
CARD_CVV=
CARD_NAME=

# (선택) 예약 결과 알림 메일. Gmail 은 "앱 비밀번호"(16자리)를 만들어 SMTP_PASSWORD 에 넣으세요.
# 확인: py book.py --test-email
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_TO=
